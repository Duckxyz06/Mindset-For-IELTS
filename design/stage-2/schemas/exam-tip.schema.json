{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Every textbook tip has its own source locator",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "sourceSection": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "exam_skills",
        "tip",
        "exam_focus",
        "language_development",
        "teacher_strategy"
      ]
    },
    "questionTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "original_en": {
      "type": "string",
      "minLength": 1
    },
    "translation_vi": {
      "type": "string",
      "minLength": 1
    },
    "tips_en": {
      "type": "string",
      "minLength": 1
    },
    "tips_vi": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1
            },
            "printedPages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "pdfPages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "sourceSection": {
              "type": "string",
              "minLength": 1
            },
            "exerciseNo": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "verificationStatus": {
              "enum": [
                "verified",
                "needs_checking"
              ]
            }
          },
          "required": [
            "document",
            "printedPages",
            "pdfPages",
            "sourceSection",
            "exerciseNo",
            "locator",
            "verificationStatus"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceType": {
      "enum": [
        "textbook",
        "teacher_authored"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "needs_checking"
      ]
    },
    "linkedExerciseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "unit",
    "sourceSection",
    "kind",
    "questionTypes",
    "original_en",
    "translation_vi",
    "tips_en",
    "tips_vi",
    "source",
    "sourceType",
    "status",
    "linkedExerciseIds"
  ],
  "additionalProperties": false
}
