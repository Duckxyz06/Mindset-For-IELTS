{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned portable progress; no audio blobs",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "appId": {
      "const": "ielts-mindset-3-study-hub"
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "settings": {
      "type": "object",
      "properties": {
        "uiLanguage": {
          "enum": [
            "vi",
            "en",
            "both"
          ]
        },
        "solutionLanguage": {
          "enum": [
            "follow",
            "vi",
            "en",
            "both"
          ]
        },
        "theme": {
          "enum": [
            "dark",
            "light"
          ]
        },
        "fontSize": {
          "type": "integer",
          "minimum": 16,
          "maximum": 24
        }
      },
      "required": [
        "uiLanguage",
        "solutionLanguage",
        "theme",
        "fontSize"
      ],
      "additionalProperties": false
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "exerciseId": {
            "type": "string",
            "minLength": 1
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "correct": {
            "type": "integer",
            "minimum": 0
          },
          "gradableCount": {
            "type": "integer",
            "minimum": 0
          },
          "needsCheckingCount": {
            "type": "integer",
            "minimum": 0
          },
          "contentRevision": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "exerciseId",
          "submittedAt",
          "answers",
          "correct",
          "gradableCount",
          "needsCheckingCount",
          "contentRevision"
        ],
        "additionalProperties": false
      }
    },
    "drafts": {
      "type": "object",
      "additionalProperties": true
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "resume": {
      "type": [
        "object",
        "null"
      ]
    },
    "recordingReferences": {
      "type": "array",
      "maxItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "appId",
    "exportedAt",
    "settings",
    "attempts",
    "drafts",
    "bookmarks",
    "notes",
    "resume",
    "recordingReferences"
  ],
  "additionalProperties": false
}
