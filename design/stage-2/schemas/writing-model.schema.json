{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Writing models with explicit origin; no invented band scores",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "integer",
      "minimum": 1
    },
    "exerciseId": {
      "type": [
        "string",
        "null"
      ]
    },
    "task": {
      "enum": [
        1,
        2
      ]
    },
    "sourceType": {
      "enum": [
        "textbook",
        "teacher_authored"
      ]
    },
    "prompt_en": {
      "type": "string",
      "minLength": 1
    },
    "modelAnswer_en": {
      "type": "string",
      "minLength": 1
    },
    "modelTranslation_vi": {
      "type": "string",
      "minLength": 1
    },
    "analysis_en": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "coherence": {
          "type": "string",
          "minLength": 1
        },
        "lexical": {
          "type": "string",
          "minLength": 1
        },
        "grammar": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task",
        "coherence",
        "lexical",
        "grammar"
      ],
      "additionalProperties": false
    },
    "analysis_vi": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "coherence": {
          "type": "string",
          "minLength": 1
        },
        "lexical": {
          "type": "string",
          "minLength": 1
        },
        "grammar": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task",
        "coherence",
        "lexical",
        "grammar"
      ],
      "additionalProperties": false
    },
    "outline_en": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outline_vi": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "languageItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          },
          "vi": {
            "type": "string",
            "minLength": 1
          },
          "translationStatus": {
            "enum": [
              "verified",
              "needs_checking"
            ]
          }
        },
        "required": [
          "en",
          "vi",
          "translationStatus"
        ],
        "additionalProperties": false
      }
    },
    "source": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "document": {
              "type": "string",
              "minLength": 1
            },
            "printedPages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "pdfPages": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "sourceSection": {
              "type": "string",
              "minLength": 1
            },
            "exerciseNo": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "verificationStatus": {
              "enum": [
                "verified",
                "needs_checking"
              ]
            }
          },
          "required": [
            "document",
            "printedPages",
            "pdfPages",
            "sourceSection",
            "exerciseNo",
            "locator",
            "verificationStatus"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "verified",
        "needs_checking"
      ]
    },
    "translationStatus": {
      "enum": [
        "verified",
        "needs_checking"
      ]
    },
    "bandClaim": {
      "const": null
    }
  },
  "required": [
    "id",
    "unit",
    "exerciseId",
    "task",
    "sourceType",
    "prompt_en",
    "modelAnswer_en",
    "modelTranslation_vi",
    "analysis_en",
    "analysis_vi",
    "outline_en",
    "outline_vi",
    "languageItems",
    "source",
    "status",
    "translationStatus",
    "bandClaim"
  ],
  "additionalProperties": false
}
