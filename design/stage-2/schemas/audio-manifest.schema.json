{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Actual supplied audio assets",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "track": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      },
      "unit": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 1,
        "maximum": 5
      },
      "file": {
        "type": "string",
        "pattern": "^audio/(unit[1-5]|additional)/track-[0-9]{2}\\.mp3$"
      },
      "originalName": {
        "type": "string",
        "minLength": 1
      },
      "durationSec": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "sizeBytes": {
        "type": "integer",
        "exclusiveMinimum": 0
      },
      "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "exerciseId": {
        "type": [
          "string",
          "null"
        ]
      },
      "exerciseIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "skill": {
        "enum": [
          "listening",
          "speaking",
          null
        ]
      },
      "mappingStatus": {
        "enum": [
          "book_reference_matched",
          "outside_scope"
        ]
      },
      "contentIdentityStatus": {
        "enum": [
          "verified",
          "needs_checking"
        ]
      },
      "audioscriptId": {
        "type": [
          "string",
          "null"
        ]
      },
      "cueStatus": {
        "enum": [
          "not_created",
          "verified",
          "needs_checking"
        ]
      },
      "fileStatus": {
        "enum": [
          "staged_original",
          "integrated"
        ]
      },
      "availableInApp": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "track",
      "unit",
      "file",
      "originalName",
      "durationSec",
      "sizeBytes",
      "sha256",
      "exerciseId",
      "exerciseIds",
      "skill",
      "mappingStatus",
      "contentIdentityStatus",
      "audioscriptId",
      "cueStatus",
      "fileStatus",
      "availableInApp"
    ],
    "additionalProperties": false
  }
}
