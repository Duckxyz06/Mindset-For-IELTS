{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://duckxyz06.github.io/Mindset-For-IELTS/schemas/exercise.schema.json",
  "title": "Verified exercise content contract",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "lessonId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSection": {
      "enum": [
        "Reading",
        "Writing",
        "Listening",
        "Speaking"
      ]
    },
    "sourceLessonNumber": {
      "type": [
        "string",
        "null"
      ]
    },
    "exerciseNo": {
      "type": "integer",
      "minimum": 1
    },
    "skill": {
      "enum": [
        "reading",
        "listening",
        "writing",
        "speaking",
        "grammar",
        "vocabulary"
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "questionType": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "foundation",
        "standard",
        "stretch",
        null
      ]
    },
    "instructions_en": {
      "type": "string",
      "minLength": 1
    },
    "instructions_vi": {
      "type": "string",
      "minLength": 1
    },
    "passageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "no": {
            "type": "integer",
            "minimum": 1
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          },
          "text_vi": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text_en": {
                  "type": "string",
                  "minLength": 1
                },
                "text_vi": {
                  "type": "string",
                  "minLength": 1
                },
                "why_wrong_en": {
                  "type": "string",
                  "minLength": 1
                },
                "why_wrong_vi": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "verified",
                    "needs_checking"
                  ]
                }
              },
              "required": [
                "id",
                "text_en",
                "text_vi",
                "why_wrong_en",
                "why_wrong_vi",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "answer": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "objective",
                  "open",
                  "sample",
                  "suggested"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "acceptedAnswers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": [
                  "verified",
                  "needs_checking",
                  "not_applicable"
                ]
              },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "document": {
                        "type": "string",
                        "minLength": 1
                      },
                      "printedPages": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "pdfPages": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "sourceSection": {
                        "type": "string",
                        "minLength": 1
                      },
                      "exerciseNo": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      },
                      "verificationStatus": {
                        "enum": [
                          "verified",
                          "needs_checking"
                        ]
                      }
                    },
                    "required": [
                      "document",
                      "printedPages",
                      "pdfPages",
                      "sourceSection",
                      "exerciseNo",
                      "locator",
                      "verificationStatus"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "normalization": {
                "type": "object",
                "properties": {
                  "caseSensitive": {
                    "type": "boolean"
                  },
                  "trim": {
                    "const": true
                  },
                  "collapseWhitespace": {
                    "type": "boolean"
                  },
                  "ignorePunctuation": {
                    "type": "boolean"
                  },
                  "wordLimit": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "allowNumber": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "caseSensitive",
                  "trim",
                  "collapseWhitespace",
                  "ignorePunctuation",
                  "wordLimit",
                  "allowNumber"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "kind",
              "value",
              "acceptedAnswers",
              "status",
              "source",
              "normalization"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "not": {
                        "type": "null"
                      }
                    },
                    "source": {
                      "allOf": [
                        {
                          "type": "object",
                          "properties": {
                            "document": {
                              "type": "string",
                              "minLength": 1
                            },
                            "printedPages": {
                              "type": "array",
                              "items": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "pdfPages": {
                              "type": "array",
                              "items": {
                                "type": "integer",
                                "minimum": 1
                              }
                            },
                            "sourceSection": {
                              "type": "string",
                              "minLength": 1
                            },
                            "exerciseNo": {
                              "type": [
                                "integer",
                                "null"
                              ],
                              "minimum": 1
                            },
                            "locator": {
                              "type": "string",
                              "minLength": 1
                            },
                            "verificationStatus": {
                              "enum": [
                                "verified",
                                "needs_checking"
                              ]
                            }
                          },
                          "required": [
                            "document",
                            "printedPages",
                            "pdfPages",
                            "sourceSection",
                            "exerciseNo",
                            "locator",
                            "verificationStatus"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "properties": {
                            "verificationStatus": {
                              "const": "verified"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "needs_checking"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    },
                    "acceptedAnswers": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          },
          "explanation": {
            "type": "object",
            "properties": {
              "explanation_en": {
                "type": "string",
                "minLength": 1
              },
              "explanation_vi": {
                "type": "string",
                "minLength": 1
              },
              "tips_en": {
                "type": "string",
                "minLength": 1
              },
              "tips_vi": {
                "type": "string",
                "minLength": 1
              },
              "translationStatus": {
                "enum": [
                  "verified",
                  "needs_checking"
                ]
              }
            },
            "required": [
              "explanation_en",
              "explanation_vi",
              "tips_en",
              "tips_vi",
              "translationStatus"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quote_en": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": "string",
                      "minLength": 1
                    },
                    "printedPages": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "pdfPages": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "sourceSection": {
                      "type": "string",
                      "minLength": 1
                    },
                    "exerciseNo": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verificationStatus": {
                      "enum": [
                        "verified",
                        "needs_checking"
                      ]
                    }
                  },
                  "required": [
                    "document",
                    "printedPages",
                    "pdfPages",
                    "sourceSection",
                    "exerciseNo",
                    "locator",
                    "verificationStatus"
                  ],
                  "additionalProperties": false
                },
                "paragraphId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "lineStart": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "lineEnd": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "audioscriptSegmentId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "verified",
                    "needs_checking"
                  ]
                }
              },
              "required": [
                "quote_en",
                "source",
                "paragraphId",
                "lineStart",
                "lineEnd",
                "audioscriptSegmentId",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "original_en": {
                  "type": "string",
                  "minLength": 1
                },
                "paraphrase_en": {
                  "type": "string",
                  "minLength": 1
                },
                "meaning_vi": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "verified",
                    "needs_checking"
                  ]
                }
              },
              "required": [
                "original_en",
                "paraphrase_en",
                "meaning_vi",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "relatedTipIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "vocabularyIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "grammarIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputType": {
            "enum": [
              "text",
              "single_choice",
              "multiple_choice",
              "tfng",
              "ynng",
              "matching",
              "ordering",
              "open"
            ]
          },
          "sourceNo": {
            "type": "string",
            "minLength": 1,
            "description": "Original printed question number or letter, e.g. 1, A or ii."
          }
        },
        "required": [
          "id",
          "no",
          "text_en",
          "text_vi",
          "options",
          "answer",
          "explanation",
          "evidence",
          "keywords",
          "relatedTipIds",
          "vocabularyIds",
          "grammarIds",
          "inputType",
          "sourceNo"
        ],
        "additionalProperties": false
      }
    },
    "audioTrack": {
      "type": [
        "string",
        "null"
      ]
    },
    "audioTracks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audioscriptId": {
      "type": [
        "string",
        "null"
      ]
    },
    "examTipIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "printedPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "pdfPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sourceSection": {
          "type": "string",
          "minLength": 1
        },
        "exerciseNo": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "needs_checking"
          ]
        }
      },
      "required": [
        "document",
        "printedPages",
        "pdfPages",
        "sourceSection",
        "exerciseNo",
        "locator",
        "verificationStatus"
      ],
      "additionalProperties": false
    },
    "contentStatus": {
      "enum": [
        "verified",
        "needs_checking"
      ]
    },
    "translationStatus": {
      "enum": [
        "verified",
        "needs_checking"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "unit",
    "lessonId",
    "sourceSection",
    "sourceLessonNumber",
    "exerciseNo",
    "skill",
    "skills",
    "questionType",
    "difficulty",
    "instructions_en",
    "instructions_vi",
    "passageId",
    "questions",
    "audioTrack",
    "audioTracks",
    "audioscriptId",
    "examTipIds",
    "source",
    "contentStatus",
    "translationStatus"
  ],
  "additionalProperties": false
}
