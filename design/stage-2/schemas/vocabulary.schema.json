{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "integer",
      "minimum": 1
    },
    "word": {
      "type": "string",
      "minLength": 1
    },
    "partOfSpeech": {
      "type": "string",
      "minLength": 1
    },
    "ipa": {
      "type": "string",
      "minLength": 1
    },
    "meaning_vi": {
      "type": "string",
      "minLength": 1
    },
    "meaning_en": {
      "type": "string",
      "minLength": 1
    },
    "example_en": {
      "type": "string",
      "minLength": 1
    },
    "translation_vi": {
      "type": "string",
      "minLength": 1
    },
    "pronunciationSource": {
      "enum": [
        "browser_tts",
        "supplied_audio",
        null
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "printedPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "pdfPages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sourceSection": {
          "type": "string",
          "minLength": 1
        },
        "exerciseNo": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "verificationStatus": {
          "enum": [
            "verified",
            "needs_checking"
          ]
        }
      },
      "required": [
        "document",
        "printedPages",
        "pdfPages",
        "sourceSection",
        "exerciseNo",
        "locator",
        "verificationStatus"
      ],
      "additionalProperties": false
    },
    "exampleSourceType": {
      "enum": [
        "textbook",
        "teacher_authored"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "needs_checking"
      ]
    },
    "translationStatus": {
      "enum": [
        "verified",
        "needs_checking"
      ]
    }
  },
  "required": [
    "id",
    "unit",
    "word",
    "partOfSpeech",
    "ipa",
    "meaning_vi",
    "meaning_en",
    "example_en",
    "translation_vi",
    "pronunciationSource",
    "source",
    "exampleSourceType",
    "status",
    "translationStatus"
  ],
  "additionalProperties": false
}
